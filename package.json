{
  "name": "legends-tracker",
  "productName": "Legends Tracker",
  "version": "2.4.0",
  "private": true,
  "description": "Spell timers, recast cues, overlays, triggers, mote and crawl tracking, and log management for EverQuest Legends.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "smoke": "node scripts/smoke.mjs",
    "icon": "electron scripts/render-icon.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "koffi@3.3.2": false
  },
  "author": "RCJuicebox",
  "homepage": "https://github.com/RCJuicebox/legends-tracker",
  "build": {
    "appId": "com.rcjuicebox.legendstracker",
    "productName": "Legends Tracker",
    "copyright": "Copyright © 2026 RCJuicebox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!node_modules/koffi/{vendor,doc,lib}/**",
      "!node_modules/koffi/cnoke.cjs",
      "!node_modules/koffi/src/koffi/CMakeLists.txt",
      "!node_modules/koffi/src/koffi/src/abi/**",
      "!node_modules/koffi/src/**/*.{cc,hh,inc,S,asm}"
    ],
    "extraResources": [
      {
        "from": "defaults",
        "to": "defaults"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Legends-Tracker-Setup-${version}.${ext}",
      "shortcutName": "Legends Tracker",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RCJuicebox",
        "repo": "legends-tracker",
        "releaseType": "release"
      }
    ]
  },
  "license": "MIT"
}
